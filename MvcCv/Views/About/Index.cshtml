@using MvcCv.Models.Entity
@model List<TblAbout>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Hakkımda Düzenleme Sayfası</h2>
<br />
<form method="post">
    @foreach (var item in Model)
    {
        <label>Ad : </label>
        <input type="text" value="@item.Name" class="form-control" name="Name" />
        <br />
        <label>Soyad : </label>
        <input type="text" value="@item.Surname" class="form-control" name="Surname" />
        <br />
        <label>Adres : </label>
        <input type="text" value="@item.Address" class="form-control" name="Address" />
        <br />
        <label>Telefon : </label>
        <input type="text" value="@item.PhoneNumber" class="form-control" name="PhoneNumber" />
        <br />
        <label>E-mail : </label>
        <input type="text" value="@item.Mail" class="form-control" name="Mail" />
        <br />
        <label>Resim : </label>
        <input type="text" value="@item.Photo" class="form-control" name="Photo" />
        <br />
        <label>Açıklama : </label>
        <textarea class="form-control" rows="5" name="Description">@item.Description</textarea>
        <br />
    }
    <button class="btn btn-primary">Kaydet</button>
</form>