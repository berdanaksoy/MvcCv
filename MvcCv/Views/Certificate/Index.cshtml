@using MvcCv.Models.Entity
@model List<TblCertificate>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{bool x = true; string a = ""; string b = "";}


<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <!-- /.col -->
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header p-2">
                            <h2 class="card-title">Sertifikalarım</h2>
                        </div>
                        <div class="card-body">
                            <div class="tab-pane" id="timeline">
                                <!-- The timeline -->
                                <div class="timeline timeline-inverse">
                                    <!-- timeline time label -->
                                    @foreach (var item in Model)
                                    {
                                        if (x == true)
                                        {
                                            a = "btn btn-info";
                                            b = "bg-info";
                                            x = false;
                                        }
                                        else
                                        {
                                            a = "btn btn-success";
                                            b = "bg-success";
                                            x = true;
                                        }
                                        <div class="time-label">
                                            <a href="/Certificate/EditCertificate/@item.ID" class="@a">
                                                <span class="@b">
                                                    @item.Date
                                                </span>
                                            </a>
                                        </div>
                                        <!-- /.timeline-label -->
                                        <!-- timeline item -->
                                        <div>
                                            <div class="timeline-item">
                                                <div class="timeline-body">
                                                    @item.Description
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <a href="/Certificate/AddCertificate" class="btn btn-primary">Sertifika Ekle</a>
                            </div>
                        </div>
                        <!-- /.tab-content -->
                    </div><!-- /.card-body -->
                </div>
                <!-- /.nav-tabs-custom -->
            </div>
            <!-- /.col -->
        </div>
    </section>
</body>
</html>