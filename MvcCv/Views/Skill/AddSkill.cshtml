@model MvcCv.Models.Entity.TblSkill

@{
    ViewBag.Title = "AddSkill";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h4>Yetenek Ekleme Sayfası</h4>
<br />
<form method="post">
    @Html.Label("Yetenek Adı : ")
    @Html.TextBoxFor(x => x.Skill, new { @class = "form-control" })
    <br />
    @Html.Label("Derece : ")
    @Html.TextBoxFor(x => x.Progress, new { @class = "form-control" })
    <br />
    <button class="btn btn-primary">Kaydet</button>
</form>