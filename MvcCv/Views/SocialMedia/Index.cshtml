@using MvcCv.Models.Entity
@model List<TblSocialMedia>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Yetenek Listesi</h3>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <button class="btn btn-info" data-toggle="modal" data-target="#Modal1">Yeni Sosyal Medya Ekle</button>
                                <br /><br />
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th style="width: 10px">#</th>
                                            <th>Platform</th>
                                            <th>Durum</th>
                                            <th>Düzenle</th>
                                            <th>Sil</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {

                                            <tr>
                                                <td>@item.Id</td>
                                                <td>@item.Name</td>
                                                @if (item.IsActive == true)
                                                {
                                                <td>Aktif</td>
                                                }
                                                else
                                                {
                                                <td>Pasif</td>
                                                }
                                                <td>
                                                    <a href="/SocialMedia/EditSocialMedia/@item.Id" class="btn btn-info btn-sm">
                                                        <i class="fas fa-pencil-alt"></i>
                                                        Düzenle
                                                    </a>
                                                </td>
                                                <td>
                                                    <a href="/SocialMedia/DeleteSocialMedia/@item.Id" class="btn btn-danger btn-sm">
                                                        <i class="fas fa-trash"></i>
                                                        Sil
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <!-- /.card-body -->
                        </div>
                        <!-- /.card -->
                    </div>
                    <!-- /.col -->
                </div>
            </div><!-- /.container-fluid -->
        </section>
        <!-- /.content -->

        <div class="modal" id="Modal1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title">Yeni Sosyal Medya Ekleme Penceresi</h2>
                    </div>
                    <form action="/SocialMedia/AddSocialMedia" method="post">
                        <div class="modal-body">
                            <label>Platform Adı : </label>
                            <input type="text" name="Name" class="form-control" placeholder="Platform Adını Giriniz..." />
                            <br />
                            <label>URL : </label>
                            <input type="text" name="Link" class="form-control" placeholder="URL Giriniz..." />
                            <br />
                            <label>İkon : </label>
                            <input type="text" name="Icon" class="form-control" placeholder="İkon Giriniz..." />
                            <br />
                            <button class="btn btn-success">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</body>
</html>