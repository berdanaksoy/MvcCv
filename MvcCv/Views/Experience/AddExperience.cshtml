@{
    ViewBag.Title = "AddExperience";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h4>Yeni Deneyim Ekleme Sayfası</h4>
<br />
<form method="post">
    <input type="text" name="Title" class="form-control" / placeholder="Başlığı Yazınız">
    <br />
    <input type="text" name="Subtitle" class="form-control" / placeholder="Alt Başlığı Yazınız">
    <br />
    <input type="text" name="Date" class="form-control" / placeholder="Tarihi Yazınız">
    <br />
    <textarea name="Description" class="form-control" placeholder="Açıklamayı Yazınız" rows="5"></textarea>
    <br />
    <button class="btn btn-primary">Kaydet</button>
</form>